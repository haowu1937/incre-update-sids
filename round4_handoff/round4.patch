+"""Meaningful graph-input contracts; standard library and synthetic data only."""
+import argparse
+import gzip
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+from genrec.temporal import build_temporal_protocol
+from genrec.temporal_graph_inputs import file_sha256, prepare_graph_inputs, stage_view
+
+
+class Checks(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.reviews = [('u', f'i{i % 4}', i, 4.0) for i in range(1, 101)]
+        # Item only in Base, item only in Base validation, and future-only item.
+        self.reviews[0] = ('singleton', 'old', 1, 4.0)
+        self.reviews[54] = ('u', 'validation_only', 55, 4.0)
+        self.reviews[90] = ('u', 'future_only', 91, 4.0)
+        self.raw = self.root / 'reviews.gz'
+        with gzip.open(self.raw, 'wt', encoding='utf-8') as handle:
+            for user, item, timestamp, rating in self.reviews:
+                handle.write(json.dumps(dict(reviewerID=user, asin=item,
+                    unixReviewTime=timestamp, overall=rating)) + '\n')
+        protocol = build_temporal_protocol(self.reviews, max_history=5)
+        self.protocol = protocol
+        self.data = self.root / 'data'
+        self.data.mkdir()
+        for name, value in (('protocol_manifest.json', protocol['manifest']),
+                            ('registries.json', protocol['registries'])):
+            (self.data / name).write_text(json.dumps(value))
+        for stage, rows in protocol['examples'].items():
+            (self.data / (stage + '.jsonl')).write_text(''.join(
+                json.dumps(row) + '\n' for row in rows))
+        self.summary = dict(execution_status='completed',
+            reviews_file_sha256=file_sha256(self.raw),
+            protocol_sha256=protocol['manifest']['protocol_sha256'],
+            resolved_config=dict(max_history=5, duplicate_policy='drop_exact'),
+            artifact_files_sha256={p.name: file_sha256(p) for p in self.data.iterdir()})
+        self.write_summary()
+
+    def write_summary(self):
+        (self.data / 'summary.json').write_text(json.dumps(self.summary))
+
+    def run_prepare(self, name='out'):
+        return prepare_graph_inputs(self.raw, self.data, self.root / name)
+
+    def test_windows_keep_first_events_and_exclude_validation_future(self):
+        result = self.run_prepare()
+        self.assertEqual(result['stages']['base']['event_count'], 54)
+        self.assertEqual(result['stages']['update']['event_count'], 18)
+        base = [json.loads(s) for s in (self.root / 'out/base/observed_events.jsonl').read_text().splitlines()]
+        update = [json.loads(s) for s in (self.root / 'out/update/observed_events.jsonl').read_text().splitlines()]
+        self.assertEqual(base[0]['user'], 'singleton')
+        self.assertEqual([r['timestamp'] for r in base], list(range(1, 55)))
+        self.assertEqual([r['timestamp'] for r in update], list(range(61, 79)))
+        for rows in (base, update):
+            self.assertNotIn('validation_only', [r['item'] for r in rows])
+            self.assertNotIn('future_only', [r['item'] for r in rows])
+
+    def test_old_catalog_nodes_retained_with_explicit_fallback_flag(self):
+        result = self.run_prepare()
+        nodes = json.loads((self.root / 'out/update/item_nodes.json').read_text())
+        by_raw = {row['raw_item_id']: row for row in nodes}
+        self.assertFalse(by_raw['old']['has_training_window_interaction'])
+        self.assertFalse(by_raw['validation_only']['has_training_window_interaction'])
+        self.assertNotIn('future_only', by_raw)
+        self.assertEqual(result['stages']['update']['nodes_without_window_interactions'], 2)
+
+    def test_noncontiguous_global_ids_and_raw_round_trip(self):
+        registry = dict(item2id={'[PAD]': 0, 'a': 3, 'b': 8, 'c': 12},
+                        user2id={'[PAD]': 0, 'u': 1})
+        events = [dict(user='u', item=raw, timestamp=t, rating=None, sample_id=str(t))
+                  for t, raw in enumerate(('c', 'a', 'b'), 1)]
+        rows, nodes, seq = stage_view(events, registry, None, 4)
+        self.assertEqual([n['gensid_global_item_id'] for n in nodes], [2, 7, 11])
+        self.assertEqual([r['graph_local_item_id'] for r in rows], [2, 0, 1])
+        for row in rows:
+            self.assertEqual(nodes[row['graph_local_item_id']]['raw_item_id'], row['item'])
+        self.assertEqual(seq[0]['gensid_global_item_ids'], [11, 2, 7])
+
+    def test_hashes_and_determinism(self):
+        a, b = self.run_prepare('a'), self.run_prepare('b')
+        self.assertEqual(a['artifact_files_sha256'], b['artifact_files_sha256'])
+        for name, expected in a['artifact_files_sha256'].items():
+            self.assertEqual(file_sha256(self.root / 'a' / name), expected)
+        self.assertEqual(a['appnp_status'], 'not_run')
+        self.assertEqual(a['E0_full_status'], 'not_run')
+
+    def test_tampered_artifact_rejected_before_output(self):
+        with (self.data / 'base_train.jsonl').open('a') as handle:
+            handle.write('{}\n')
+        with self.assertRaisesRegex(ValueError, 'checksum'):
+            self.run_prepare()
+        self.assertFalse((self.root / 'out').exists())
+
+    def test_different_raw_input_rejected(self):
+        with self.raw.open('ab') as handle:
+            handle.write(b'changed')
+        with self.assertRaisesRegex(ValueError, 'checksum'):
+            self.run_prepare()
+        self.assertFalse((self.root / 'out').exists())
+
+    def test_inconsistent_registry_rejected_even_if_hash_updated(self):
+        path = self.data / 'registries.json'
+        value = json.loads(path.read_text())
+        value['base_train']['item2id']['old'] = 999
+        path.write_text(json.dumps(value))
+        self.summary['artifact_files_sha256'][path.name] = file_sha256(path)
+        self.write_summary()
+        with self.assertRaisesRegex(ValueError, 'reproduced'):
+            self.run_prepare()
+
+    def test_no_overwrite_or_incomplete_reuse(self):
+        self.run_prepare()
+        with self.assertRaises(FileExistsError):
+            self.run_prepare()
+        (self.root / 'second.incomplete').mkdir()
+        with self.assertRaises(FileExistsError):
+            self.run_prepare('second')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--output', required=True)
+    args = parser.parse_args()
+    output = Path(args.output)
+    output.mkdir(parents=True, exist_ok=False)
+    result = unittest.TextTestRunner(verbosity=2).run(
+        unittest.defaultTestLoader.loadTestsFromTestCase(Checks))
+    checks = dict(round='round4', inputs='synthetic_only', tests_run=result.testsRun,
+                  execution_status='passed' if result.wasSuccessful() else 'failed',
+                  E0_full_status='not_run', E1_status='not_run')
+    (output / 'checks.json').write_text(json.dumps(checks, indent=2) + '\n')
+    sys.exit(0 if result.wasSuccessful() else 1)
