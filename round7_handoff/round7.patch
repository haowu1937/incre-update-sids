+    def fit_steps(self, features, global_ids, max_steps, batch_size, seed,
+                  state=None, on_step=None):
+        """Opt-in pure-content training with exact, resumable optimizer steps.
+
+        Initialization, artifact checks and checkpoint writing are orchestrated
+        by gensid.incremental_content. Existing epoch fit remains available.
+        """
+        if self.graph_encoder or not self.plain_reconstruction or self.use_sk:
+            raise ValueError("fit_steps requires pure content, plain reconstruction and disable_sk")
+        if max_steps < 1 or batch_size < 1 or len(features) == 0:
+            raise ValueError("Invalid step budget/batch size or empty features")
+        generator = torch.Generator(device="cpu")
+        generator.manual_seed(seed)
+        state = state or {"step": 0, "cursor": 0, "order": None,
+                          "epoch": 0, "processed_examples": 0}
+        state = dict(state)
+        if "generator_state" in state:
+            generator.set_state(state["generator_state"])
+        if state["step"] > max_steps:
+            raise ValueError("Resume checkpoint exceeds requested target steps")
+        n = len(features)
+        self.model.train()
+        while state["step"] < max_steps:
+            if state["order"] is None or state["cursor"] == n:
+                state["order"] = torch.randperm(n, generator=generator)
+                state["cursor"] = 0
+                state["epoch"] += 1
+            end = min(n, state["cursor"] + batch_size)
+            selected = state["order"][state["cursor"]:end]
+            data = features[selected].to(self.device)
+            ids = global_ids[selected].to(self.device)
+            self.optimizer.zero_grad(set_to_none=True)
+            out, rq_loss, indices, dense, codes, residuals = self.model(data, None, use_sk=False)
+            loss, aux, recon, quant = self.model.compute_loss(out, rq_loss, ids, dense,
+                dense_out_codebooks=codes, x_res_list=residuals, xs=data)
+            self._check_nan(loss)
+            loss.backward()
+            if any(p.grad is not None and not torch.isfinite(p.grad).all()
+                   for p in self.model.parameters()):
+                raise ValueError("Nonfinite tokenizer gradient")
+            self.optimizer.step()
+            state["cursor"] = end
+            state["step"] += 1
+            state["processed_examples"] += len(selected)
+            state["generator_state"] = generator.get_state()
+            metrics = {"step": state["step"], "epoch": state["epoch"],
+                "processed_examples": state["processed_examples"],
+                "total_loss": float(loss.detach()), "reconstruction_loss": float(recon),
+                "quantization_loss": float(quant.detach()),
+                "aux_loss": float(aux) if torch.is_tensor(aux) else aux}
+            if on_step is not None:
+                on_step(state, metrics)
+        return state
