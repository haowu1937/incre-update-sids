+    @classmethod
+    def for_temporal(cls, config, model, tokenizer):
+        """Single-device, opt-in fixed-step training of the same repository model."""
+        trainer = cls.__new__(cls)
+        trainer.config, trainer.model = config, model
+        trainer.evaluator = Evaluator(config, tokenizer)
+        trainer.optimizer = AdamW(model.parameters(), lr=config['lr'],
+                                  weight_decay=config['weight_decay'])
+        # A budget-independent schedule permits exact smoke -> full continuation.
+        trainer.scheduler = get_scheduler('constant_with_warmup', trainer.optimizer,
+                                         num_warmup_steps=config['warmup_steps'])
+        return trainer
+
+    def fit_steps(self, arrays, sampler, generator, target_steps, make_batch, on_step):
+        """Continue sampler/optimizer state and stop at exactly target_steps."""
+        count = len(arrays['labels'])
+        self.model.train()
+        while sampler['optimizer_steps'] < target_steps:
+            if sampler['order'] is None or sampler['cursor'] == count:
+                sampler['order'] = torch.randperm(count, generator=generator)
+                sampler['cursor'] = 0
+                sampler['epochs_started'] += 1
+            end = min(sampler['cursor'] + self.config['batch_size'], count)
+            indices = sampler['order'][sampler['cursor']:end].numpy()
+            batch = make_batch(arrays, indices)
+            self.optimizer.zero_grad(set_to_none=True)
+            loss = self.model(batch).loss
+            if not torch.isfinite(loss):
+                raise FloatingPointError('Non-finite TIGER training loss')
+            loss.backward()
+            norm = clip_grad_norm_(self.model.parameters(), self.config['max_grad_norm'])
+            if not torch.isfinite(norm):
+                raise FloatingPointError('Non-finite TIGER gradient norm')
+            self.optimizer.step()
+            self.scheduler.step()
+            sampler['cursor'] = end
+            sampler['optimizer_steps'] += 1
+            sampler['processed_examples'] += len(indices)
+            on_step(float(loss.detach()), float(norm))
     
     
